            "body": {
              "mode": "raw",
              "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"78s7503h9ug86ueg1a9icbhe9m\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"testcustomer\",\n    \"PASSWORD\": \"Claims!Test123\"\n  }\n}"
            },
