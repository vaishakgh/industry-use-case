      "item": [
        {
          "name": "Get Token (copy IdToken from response)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();\r",
                  "var idToken = response.AuthenticationResult.IdToken;\r",
                  "pm.collectionVariables.set(\"token\", idToken);\r",
                  "console.log(\"Token refreshed, expires in: \" + response.AuthenticationResult.ExpiresIn + \"s\");\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
